{
  "uid": "eda-overview",
  "title": "EDA demo – overview",
  "tags": [
    "eda-demo",
    "kafka",
    "spring-boot"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP (order-service)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, method, uri, status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{application}} {{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP latency p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p50 {{method}} {{uri}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p95 {{method}} {{uri}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p99 {{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Kafka",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages produced (msg/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, topic) (rate(eda_messages_produced_total[1m]))",
          "legendFormat": "{{application}} → {{topic}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Messages consumed (msg/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, topic, outcome) (rate(eda_messages_consumed_total[1m]))",
          "legendFormat": "{{application}} ← {{topic}} ({{outcome}})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Consumer lag (records)",
      "description": "Součet lagu přes partitions z metrik Kafka klienta. Klient publikuje každou metriku i s legacy tagem, kde jsou tečky v názvu topicu nahrazené podtržítky – ty filtrujeme.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, topic) (max by (application, topic, partition) (kafka_consumer_fetch_manager_records_lag{topic!~\".*_.*\"}))",
          "legendFormat": "{{application}} {{topic}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Dead-lettered messages (total)",
      "description": "Zprávy přesunuté do *.DLT po vyčerpání retry (od startu podu).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (eda_messages_dead_lettered_total)",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DLT rate & duplicates skipped (msg/min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (increase(eda_messages_dead_lettered_total[1m]))",
          "legendFormat": "DLT {{topic}}"
        },
        {
          "refId": "B",
          "expr": "sum by (application, topic) (increase(eda_messages_consumed_total{outcome=\"duplicate\"}[1m]))",
          "legendFormat": "duplicate {{application}} {{topic}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM heap used vs max",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}} used"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "{{application}} max"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "JVM non-heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"nonheap\"})",
          "legendFormat": "{{application}} non-heap"
        }
      ]
    }
  ]
}